# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.dll

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and secrets
.env
.env.*
*.env
!.env.example

# IDE / Editor configurations
.vscode/
.idea/

# AI Model Weights (Include required YOLO project model weights)
*.pt
*.pth
*.onnx
*.bin
!backend/yolov8n.pt
!backend/helmet_yolov8n.pt

# Media files in root (Sample videos are preserved in frontend/)
/*.mp4
/*.MP4
/*.avi
/*.mov

# Reports and temporary development artifacts
*_REPORT.md
*_DIAGNOSIS.md

# Application runtime storage (Preserve directories via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/evidence/*
!backend/evidence/.gitkeep

# Testing, caches, and scratch files
.pytest_cache/
.mypy_cache/
scratch/
benchmarks/
.git_archive/
*.git_archive/
**/.git_archive/

# Logs, databases, and OS metadata
*.log
*.sqlite
*.sqlite3
.DS_Store
Thumbs.db